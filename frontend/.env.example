# ============================================================
# MINDHAVEN FRONTEND ENVIRONMENT VARIABLES
# ============================================================
#
# Copy this file to `.env` for local development, or set these
# variables in your hosting dashboard (Vercel / Netlify).
#
# NEVER put real secrets here. Vite only exposes variables that
# start with VITE_ to the browser bundle. Keep all backend
# credentials (MongoDB, JWT, SMTP, Cloudinary) in the BACKEND
# environment only — never in the frontend.

# --- Local development (defaults) ---------------------------
# VITE_API_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000

# --- Production (set these in your hosting dashboard) -------
# API base URL of your deployed backend (no trailing slash at the end
# of the domain, but keep `/api`).
VITE_API_URL=https://YOUR-BACKEND-DOMAIN/api

# Socket.IO / WebSocket URL of your deployed backend.
# Use wss:// for secure HTTPS connections.
VITE_SOCKET_URL=wss://YOUR-BACKEND-DOMAIN
