# ============================================================
# MINDHAVEN BACKEND ENVIRONMENT VARIABLES
# ============================================================
# Copy to `.env` locally, or set these in your hosting dashboard
# (Render / Railway / Fly.io). NEVER commit the real `.env`.

# --- Server -------------------------------------------------
PORT=5000
# Use production in deployed environments to enable production behaviors.
NODE_ENV=production

# Frontend (browser) origin(s) allowed to call the API / connect
# to Socket.IO. For a single deployed frontend this is its full origin.
# Separate multiple origins with a comma:
# FRONTEND_URL=https://mindhaven.yourdomain.com,http://localhost:5173
FRONTEND_URL=https://YOUR-FRONTEND-DOMAIN

# --- Database (existing MongoDB Atlas) ----------------------
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/mindhaven?retryWrites=true&w=majority

# --- JWT ----------------------------------------------------
JWT_SECRET=replace_with_a_long_random_secret_a
JWT_REFRESH_SECRET=replace_with_a_long_random_secret_b
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- Email (SMTP) -------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME=MindHaven Support

# --- Cloudinary (file/photo uploads) ------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
